{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": $mod_authors,
  "contact": {
    "homepage": "https://github.com/Mai-xiyu/OneKeyMiner",
    "sources": "https://github.com/Mai-xiyu/OneKeyMiner"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.xiyu.onekeyminer.fabric.OneKeyMinerFabric"
    ],
    "client": [
      "org.xiyu.onekeyminer.fabric.OneKeyMinerFabricClient"
    ]
  },
  "mixins": [
    "onekeyminer.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/onekeyminer"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": $compatible_mc_versions,
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
