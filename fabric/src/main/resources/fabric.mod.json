{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "一键连锁挖矿模组 - 支持矿石、原木等方块的连锁挖掘",
  "authors": $mod_authors,
  "contact": {
    "homepage": "https://github.com/Mai-xiyu/OneKeyMiner",
    "sources": "https://github.com/Mai-xiyu/OneKeyMiner",
    "issues": "https://github.com/Mai-xiyu/OneKeyMiner/issues"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.xiyu.onekeyminer.fabric.OneKeyMinerFabric"
    ],
    "client": [
      "org.xiyu.onekeyminer.fabric.OneKeyMinerFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": $compatible_mc_versions,
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
